{
  "name": "music-creator",
  "version": "1.0.0",
  "description": "伝えたいメッセージから Suno 用の楽曲を作る制作システム",
  "scripts": {
    "build": "esbuild app=src/main.js claude=src/vendor-claude.js gemini=src/vendor-gemini.js --bundle --format=iife --platform=browser --target=es2020 --minify --outdir=dist && node scripts/build-textbook.mjs",
    "dev": "esbuild app=src/main.js claude=src/vendor-claude.js gemini=src/vendor-gemini.js --bundle --format=iife --platform=browser --target=es2020 --outdir=dist --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shomayamamoto-ai/music.creator.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/shomayamamoto-ai/music.creator/issues"
  },
  "homepage": "https://github.com/shomayamamoto-ai/music.creator#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@google/genai": "^3.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "private": true,
  "type": "module"
}
